	<munit:test name="cf-api-main-error-handler-api-kit-bad-request-test" doc:id="89911574-91c4-49ff-954f-1a199686ce1b" description="Test" >
		<munit:behavior >
			<munit-tools:mock-when doc:name="api-kit-bad-request" doc:id="58963d79-756d-4fd4-80ff-bc06d2bfbd18" processor="apikit:router">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="api-config" attributeName="config-ref" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:error typeId="APIKIT:BAD_REQUEST" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when doc:name="Publish Message Kafka Error" doc:id="7b0bf56a-51d4-49c2-b8e7-eafa07afd933" processor="kafka:publish">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="${elk.kafka.topic}" attributeName="topic" />
				</munit-tools:with-attributes>
			</munit-tools:mock-when>
		</munit:behavior>
	</munit:test>
