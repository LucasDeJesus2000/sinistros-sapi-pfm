<?xml version="1.0" encoding="UTF-8"?>

<mule
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">

	<flow
		name="api-alive"
		doc:id="49cb30bd-ddd2-4f76-8a7f-25cb64b660ae">
		
		<http:listener
			doc:name="GET /alive"
			doc:id="1ea1e34d-8be7-428b-85a5-be2f12f2ed39"
			config-ref="sinistros-sapi-pfm-httpListenerConfig"
			path="/alive"
			allowedMethods="GET">
			
			<http:error-response>
				<http:body><![CDATA[#['DOWN']]]></http:body>
			</http:error-response>
			
		</http:listener>
		
		<set-payload
			value="UP"
			doc:name="Set Payload"
			doc:id="3cf94ed2-e03c-4b74-9e5f-ed56e3c28868" />
			
	</flow>

	<flow
		name="api-ready"
		doc:id="19a991a3-965c-4dff-9429-3f266aaf8873">
		
		<http:listener
			doc:name="GET /ready"
			doc:id="ecb8d7cf-3b7b-41b5-94de-7ec5c2c4705a"
			config-ref="sinistros-sapi-pfm-httpListenerConfig"
			path="/ready"
			allowedMethods="GET">
			
			<http:error-response>
				<http:body><![CDATA[#['DOWN']]]></http:body>
			</http:error-response>
			
		</http:listener>
		
		<flow-ref
			doc:name="check-all-other-dependencies-are-alive"
			doc:id="a2a48e6b-9806-439f-a6a3-92a679d5e7a3"
			name="check-all-other-dependencies-are-alive" />
			
		<set-payload
			value="#[payload]"
			doc:name="Set Payload"
			doc:id="3460395f-2085-4a73-97f3-edb29a15e554" />
			
	</flow>

	<sub-flow
		name="check-all-other-dependencies-are-alive"
		doc:id="d928e7d0-54ab-4e22-98f9-bac6840d3c55">
		
		<set-payload value="#[${file::dwl/health/c-check-dependencies.dwl}]" doc:name="c-check-dependencies.dwl" doc:id="c9d782db-4651-4c0b-bfd9-738947bcd363" />
			
	</sub-flow>

</mule>